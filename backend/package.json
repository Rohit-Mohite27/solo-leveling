{
  "name": "solo-leveling-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:railway": "tsx src/server.ts",
    "start:with-migrate": "drizzle-kit push --force && tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.30.4",
    "drizzle-orm": "0.39.3",
    "express": "4.21.2",
    "mysql2": "3.12.0",
    "tsx": "4.19.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.13.10",
    "typescript": "5.8.2"
  }
}
