# Copy to .env locally. On Render, set these in Variables UI.
# Do not commit real secrets.

DATABASE_URL=mysql://root:PASSWORD@127.0.0.1:3306/solo_leveling
# DATABASE_SSL=false

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,https://solo-leveling-azure-rho.vercel.app
SESSION_SECRET=change-me-to-a-long-random-secret

# static = fixed code (local)
# resend = email OTP via Resend
OTP_MODE=static
STATIC_OTP=123456

RESEND_API_KEY=
# Until you verify a domain, Resend allows onboarding@resend.dev
OTP_FROM_EMAIL=Solo Leveling <onboarding@resend.dev>
