# Copy to .env locally. On Render, set these in Variables UI.
# Do not commit real secrets.

DATABASE_URL=mysql://root:PASSWORD@127.0.0.1:3306/solo_leveling

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,https://solo-leveling-azure-rho.vercel.app
SESSION_SECRET=change-me-to-a-long-random-secret

# static = fixed code | textbee = SMS via your Android phone (TextBee)
OTP_MODE=static
STATIC_OTP=123456

TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
SMS_COUNTRY_CODE=91
