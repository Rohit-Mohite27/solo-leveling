# Copy to .env locally. On Railway, set these in the service Variables UI.
# Do not commit real secrets.

# MySQL — local, TiDB Cloud, etc.
DATABASE_URL=mysql://root:PASSWORD@127.0.0.1:3306/solo_leveling

# TiDB Cloud needs TLS. In production we auto-enable SSL; set false for local plain MySQL.
# DATABASE_SSL=false

PORT=4000
NODE_ENV=development

# Frontend origin(s), comma-separated.
# Local: http://localhost:3000
# Production stable URL (also auto-allows https://solo-leveling*.vercel.app)
CORS_ORIGIN=http://localhost:3000,https://solo-leveling-azure-rho.vercel.app

# At least 16 random characters. Generate a new one for production.
SESSION_SECRET=change-me-to-a-long-random-secret

# static = fixed OTP for local/dev (also OK briefly on Railway until MSG91 is ready)
# msg91 = real SMS
OTP_MODE=static
STATIC_OTP=123456

# Required only when OTP_MODE=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_COUNTRY_CODE=91
